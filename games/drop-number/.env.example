# Telemetry is off by default: nothing to set to run, test or build this game.
# NB_CONSOLE_ENV: local | dev | live | off. Empty or unknown => SDK off.
#
# `pnpm dev` (vite dev) reads .env.development.local; empty => off.
# `nibi sim | dev | build` run `vite build --mode nibi` and read .env.nibi then .env.nibi.local.
# .env.nibi (committed) sets NB_CONSOLE_ENV=off. To send events to the dev Console, ask the team for the
# events key and put both lines in .env.nibi.local (gitignored). Never commit a key.
NB_CONSOLE_ENV=dev
NB_CONSOLE_EVENTS_KEY=
